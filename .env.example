# ==========================================
# SMART LINK NG — ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Authentication & Services (Phase 1)
# -------------------------------------------------------------
# Required for client-side Supabase Auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase keys (CRITICAL: NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Server Configuration
# -------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_URL=

# Super Administrator
# -------------------------------------------------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Authentication Custom SMTP (Gmail)
# -------------------------------------------------------------
# Authentication email account (separate from business/admin email)
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_EMAIL_FROM="Smart Link NG Security" <no-reply@smartlinkng.com.ng>

# Turso Database (Phase 5 - SQLite/libSQL)
# -------------------------------------------------------------
# Remote Turso database URL (e.g., libsql://smartlink-prod-xyz.turso.io)
# Or local file fallback (e.g., file:src/data/smartlink.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini API (Server-side only)
# -------------------------------------------------------------
GEMINI_API_KEY=

# Payment & Identity Provider API Keys (Server-side only)
# -------------------------------------------------------------
# ASPFIY (Payments & Virtual Accounts - left untouched)
ASPFIY_SECRET_KEY=
ASPFIY_PUBLIC_KEY=

# LumiID Sovereign Identity Gateway (lumiid.com)
# Base URL (https://api.lumiid.com) and App ID are built into the project
LUMIID_API_KEY=

# NIN BVN Portal (ninbvnportal.com)
# Base URL (https://ninbvnportal.com/api) and App ID are built into the project
NINBVNPORTAL_API_KEY=

# VerifyNG Identity Gateway (kyc.edirect.ng / verifyn.ng)
# Base URL (https://api.verifyn.ng/api/v1) and App ID are built into the project
VERIFYNG_API_KEY=

# Clubkonnect VTU & Bill Payments (clubkonnect.com)
# Base URL (https://www.clubkonnect.com/API) and User/App ID are built into the project
CLUBKONNECT_API_KEY=

