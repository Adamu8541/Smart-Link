rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "adamuamuhammad8541@gmail.com" ||
        request.auth.token.email == "admin@smartlinkng.com.ng" ||
        request.auth.token.email == "admin@smartlink.ng" ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == "SUPER_ADMIN" ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "SUPER_ADMIN") ||
        (exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == "SUPER_ADMIN") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "SUPER_ADMIN")
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.token.admin == true ||
        request.auth.token.role == "ADMIN" ||
        request.auth.token.role == "SUB_ADMIN" ||
        request.auth.token.role == "STAFF" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["SUPER_ADMIN", "ADMIN", "SUB_ADMIN", "STAFF", "FINANCE_MANAGER", "SUPPORT_OFFICER", "VERIFICATION_OFFICER", "READ_ONLY_AUDITOR"])
      );
    }

    // 1. USERS COLLECTION
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // 2. WALLETS COLLECTION
    match /wallets/{walletId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isOwner(walletId) || isAdmin());
      allow write: if isAdmin();
    }

    // 3. WALLET SUMMARY COLLECTION
    match /wallet_summary/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 4. WALLET TRANSACTIONS COLLECTION
    match /wallet_transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Legacy alias for backwards compatibility
    match /transactions/{txnId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 5. WALLET LEDGER COLLECTION
    match /wallet_ledger/{ledgerId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 6. PAYMENT SESSIONS COLLECTION
    match /payment_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 7. WEBHOOK EVENTS COLLECTION
    match /webhook_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // 8. NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "isRead"]) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // 9. AUDIT LOGS & ACTIVITY LOGS
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 10. APP SETTINGS & SYSTEM CONFIGURATION
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /maintenance_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_configuration/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. SERVICE PRICING & CONFIGURATION
    match /service_pricing/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services_catalog/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /api_providers/{providerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 12. SLIPS AND SLIP VALIDATIONS (Phase 1 Identity Slips)
    match /slips/{slipId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 13. CAC & MANUAL SERVICE ORDERS
    match /cac_applications/{appId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /manual_service_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 14. LEGAL ACCEPTANCES & POLICY VERSIONING
    match /legal_acceptances/{acceptanceId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /legal_policies/{policyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /marketing_consents/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 15. REFUNDS, REPORTS & RECONCILIATION
    match /refunds/{refundId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /settlement_reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /reconciliation_reports/{reportId} {
      allow read, write: if isAdmin();
    }

    match /virtual_accounts/{accId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // 16. TEST & PROBE
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 17. ADMIN PRIVILEGES LIST
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /admin_users/{adminUid} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // Catch-all Deny for unmatched
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
