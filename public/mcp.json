{
  "$schema": "https://modelcontextprotocol.io/schema.json",
  "name": "SmartLink NG Model Context Protocol (MCP)",
  "version": "1.0.0",
  "description": "Web Model Context Protocol (WebMCP) and Server MCP tools specification for SmartLink NG - Nigeria's premier identity verification, CAC registration, and utility billing platform.",
  "homepage": "https://smartlinkng.com.ng",
  "documentation": "https://smartlinkng.com.ng/llms.txt",
  "knowledge_base": "https://smartlinkng.com.ng/llms-full.txt",
  "tools": [
    {
      "name": "verify_identity",
      "description": "Verify Nigerian National Identity Number (NIN) or Bank Verification Number (BVN) and return verified demographic details with official slip download links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["nin", "bvn", "vnin"],
            "description": "Type of identity record to verify"
          },
          "identifier": {
            "type": "string",
            "description": "11-digit NIN, 11-digit BVN, or 16-character virtual NIN (vNIN)"
          }
        },
        "required": ["type", "identifier"]
      }
    },
    {
      "name": "verify_electricity_meter",
      "description": "Validate a Nigerian electricity prepaid or postpaid meter number with the designated distribution company (Disco) before purchase.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "disco": {
            "type": "string",
            "enum": ["ikeja-electric", "eko-electric", "abuja-electric", "ibadan-electric", "enugu-electric", "kano-electric", "port-harcourt-electric", "jos-electric", "kaduna-electric", "benin-electric", "yola-electric", "aba-electric"],
            "description": "Electricity distribution company"
          },
          "meterNumber": {
            "type": "string",
            "description": "10-to-13 digit meter or account number"
          },
          "meterType": {
            "type": "string",
            "enum": ["prepaid", "postpaid"],
            "description": "Meter billing type"
          }
        },
        "required": ["disco", "meterNumber", "meterType"]
      }
    },
    {
      "name": "purchase_electricity_token",
      "description": "Purchase instant STS 20-digit prepaid electricity meter tokens across all 11 Nigerian Discos with zero surcharge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "disco": {
            "type": "string",
            "description": "Electricity distribution company identifier"
          },
          "meterNumber": {
            "type": "string",
            "description": "Target meter number"
          },
          "amount": {
            "type": "number",
            "description": "Recharge amount in Naira (NGN)"
          },
          "phone": {
            "type": "string",
            "description": "11-digit recipient phone number to receive token"
          }
        },
        "required": ["disco", "meterNumber", "amount", "phone"]
      }
    },
    {
      "name": "purchase_data_bundle",
      "description": "Vending cheap wholesale SME, corporate, and gifting mobile data bundles for MTN, Airtel, Glo, and 9mobile in Nigeria.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "enum": ["mtn", "airtel", "glo", "9mobile"],
            "description": "Mobile telecommunication network"
          },
          "planId": {
            "type": "string",
            "description": "Bundle identifier (e.g., mtn-sme-1gb, glo-data-2gb)"
          },
          "phone": {
            "type": "string",
            "description": "11-digit Nigerian recipient mobile number"
          }
        },
        "required": ["network", "planId", "phone"]
      }
    },
    {
      "name": "explore_services",
      "description": "Retrieve the comprehensive list and pricing of all 25+ digital identity, compliance filing, and utility payment services available on SmartLink NG.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["all", "verification", "bills", "corporate", "api"],
            "description": "Service category filter"
          }
        }
      }
    }
  ]
}
