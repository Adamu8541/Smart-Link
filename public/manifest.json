{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Smart Link NG - Identity, CAC & VTU Portal",
  "short_name": "SmartLink NG",
  "description": "Nigeria's all-in-one digital portal for NIN Verification & Slip Printing, BVN Validation, CAC Registration, Electricity Disco Tokens, cheap VTU Data & Airtime, and Developer APIs.",
  "id": "https://smartlinkng.com.ng/",
  "start_url": "/?mode=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0F2D5C",
  "theme_color": "#0F2D5C",
  "lang": "en-NG",
  "dir": "ltr",
  "categories": ["finance", "utilities", "business", "productivity"],
  "prefer_related_applications": false,
  "related_applications": [],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Smart Link NG Portal on Desktop"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Smart Link NG Mobile App Screen"
    }
  ],
  "shortcuts": [
    {
      "name": "NIN Verification",
      "short_name": "NIN Verify",
      "description": "Instant NIN lookup, validation and slip print",
      "url": "/verification",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "BVN Validation",
      "short_name": "BVN Verify",
      "description": "Instant Bank Verification Number check and wallet slip",
      "url": "/verification",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Buy Airtime & Data",
      "short_name": "VTU Data",
      "description": "MTN SME, Glo, Airtel data bundles and electricity meter tokens",
      "url": "/bills",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "CAC Registration",
      "short_name": "CAC Business",
      "description": "Corporate Affairs Commission business name registration and filing",
      "url": "/cac",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
